{
    "name": "yetidevworks/yetipdf",
    "description": "Fast, dependency-free PDF text extraction for PHP, built for search indexing",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "text", "extraction", "search", "indexing"],
    "authors": [
        {
            "name": "Yetidevworks",
            "email": "info@yetidevworks.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "suggest": {
        "ext-openssl": "Needed to read AES-encrypted PDFs",
        "ext-mbstring": "Needed for PDFs using legacy CJK encodings (Shift-JIS, GBK, Big5, UHC)"
    },
    "autoload": {
        "psr-4": {
            "YetiPdf\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YetiPdf\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/yetipdf"],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}

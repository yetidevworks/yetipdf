{
    "name": "yetidevworks/yetipdf-read",
    "description": "Fast, dependency-free PDF text extraction for PHP, built for search indexing",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "text", "extraction", "search", "indexing"],
    "authors": [
        {
            "name": "Yetidevworks",
            "email": "info@yetidevworks.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-zlib": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "replace": {
        "yetidevworks/yetipdf": "self.version"
    },
    "suggest": {
        "ext-openssl": "Needed to read AES-encrypted PDFs",
        "ext-mbstring": "Needed for PDFs using legacy CJK encodings (Shift-JIS, GBK, Big5, UHC)"
    },
    "autoload": {
        "psr-4": {
            "YetiPdf\\Read\\": "src/"
        },
        "files": ["src/legacy.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "YetiPdf\\Read\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/yetipdf-read", "bin/yetipdf"],
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.3.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
